## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Node/Vite
node_modules/
**/node_modules/
**/dist/

# Local runtime data
data/

# Docker — developer-local compose overrides + env files
docker-compose.override.yml
compose.override.yml
.env
.env.local
.env.*.local
# Phase J Wave 8 — dev-only secret bundles + secret-bearing appsettings
.env.dev
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json

# Phase K Wave 2 — Apone (DevOps). Capacitor regenerated platform dirs.
# `npx cap add ios` / `npx cap add android` regenerate these from
# package.json + capacitor.config.json deterministically — committing
# them only creates Xcode-project-file / Gradle merge conflicts.
mobile/ios/
mobile/android/
mobile/node_modules/
mobile/build/
mobile/.gradle/
mobile/*.tgz

# Phase K Wave 9 — Apone (DevOps). The .work/ directory is the squad's
# session-scratch area: helm render outputs, per-agent backups
# (.work/apone-w9-safe/), the W10+ squad-git-lock file, etc. Nothing
# under .work/ is meant to land in git, EXCEPT .work/.gitkeep — that
# placeholder guarantees the directory exists on a fresh clone so
# `flock 9>.work/squad-git-lock` and `helm template ... > .work/...`
# don't fail on a missing parent.
.work/*
!.work/.gitkeep
