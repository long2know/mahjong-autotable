{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Backend",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api/bin/Debug/net10.0/Mahjong.Autotable.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api",
      "preLaunchTask": "backend: build",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "PATH": "${env:HOME}/.dotnet:/usr/share/dotnet:/usr/local/share/dotnet:${env:PATH}"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/autotable/"
      }
    },
    {
      "name": "Backend + Autotable Baseline",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api/bin/Debug/net10.0/Mahjong.Autotable.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api",
      "preLaunchTask": "backend: build",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "PATH": "${env:HOME}/.dotnet:/usr/share/dotnet:/usr/local/share/dotnet:${env:PATH}"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/autotable/"
      }
    },
    {
      "name": "Autotable (Vite watch)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run watch",
      "cwd": "${workspaceFolder}/src/frontend/autotable-src"
    }
  ],
  "compounds": [
    {
      "name": "F5 Full Stack (Backend + Autotable)",
      "configurations": [
        ".NET Backend",
        "Autotable (Vite watch)"
      ],
      "stopAll": true
    }
  ]
}
