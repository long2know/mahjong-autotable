{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api/Mahjong.Autotable.Api.csproj"
      ],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.dotnet:/usr/share/dotnet:/usr/local/share/dotnet:${env:PATH}"
        }
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/backend/src/Mahjong.Autotable.Api/Mahjong.Autotable.Api.csproj"
      ],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.dotnet:/usr/share/dotnet:/usr/local/share/dotnet:${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*watch.*",
          "endsPattern": ".*Now listening on:.*"
        }
      }
    },
    {
      "label": "autotable: watch",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/frontend/autotable-src"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
