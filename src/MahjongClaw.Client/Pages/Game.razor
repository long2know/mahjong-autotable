    {
        <= 4 => "East",
        <= 8 => "South",
        <= 12 => "West",
        _ => "North"
    };

    private static bool IsLiveGameActive(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(status, "In Progress", StringComparison.OrdinalIgnoreCase);

    private static bool IsBotName(string name)
        => name.StartsWith("Bot", StringComparison.OrdinalIgnoreCase);

    private bool HasLegalAction(string action)
        => _liveState?.LegalActions?.Any(candidate =>
               string.Equals(candidate, action, StringComparison.OrdinalIgnoreCase)) == true;

    private static string NormalizeGameStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Unknown";
        }

        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return "In Progress";
        }

        if (string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "Complete";
        }

        return status;
    }

    private static string NormalizeTurnPhase(string? turnPhase, string? status)
    {
        if (string.IsNullOrWhiteSpace(turnPhase))
        {
            return NormalizeGameStatus(status);
        }

        return turnPhase switch
        {
            "NotStarted" => "Waiting",
            "Completed" => "Complete",
            _ => turnPhase
        };
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Waiting" => "text-bg-info",
        "In Progress" => "text-bg-success",
        "Paused" => "text-bg-warning",
        "Complete" => "text-bg-secondary",
        "Unknown" => "text-bg-dark",
        _ => "text-bg-primary"
    };

    private static readonly string[] WallSides = ["North", "East", "South", "West"];

    private int TotalWallStacks => (int)Math.Ceiling(WallTotal / 2d);

    private IReadOnlyDictionary<string, int> BuildWallStackCounts()
    {
        var totalStacks = TotalWallStacks;
        var baseStacks = totalStacks / WallSides.Length;
        var remainder = totalStacks % WallSides.Length;
        var counts = new Dictionary<string, int>(WallSides.Length);

        for (var i = 0; i < WallSides.Length; i++)
        {
            counts[WallSides[i]] = baseStacks + (i < remainder ? 1 : 0);
        }

        return counts;
    }

    private IEnumerable<WallStackView> BuildWallSide(string side)
    {
        var counts = BuildWallStackCounts();
        var breakSide = (HandNumber % 4) switch
        {
            0 => "East",
            1 => "South",
            2 => "West",
            _ => "North"
        };

        if (!counts.TryGetValue(breakSide, out var breakSideCount) || breakSideCount == 0)
        {
            yield break;
        }

        var breakIndex = Math.Clamp((HandNumber * 2) % breakSideCount, 0, breakSideCount - 1);
        var breakGapIndex = (breakIndex + 1) % breakSideCount;
        var drawStartIndex = GetSideOffset(counts, breakSide) + breakIndex;

        var stacksRemaining = Math.Clamp((int)Math.Ceiling(WallRemaining / 2d), 0, TotalWallStacks);
        var stacksConsumed = TotalWallStacks - stacksRemaining;

        if (!counts.TryGetValue(side, out var sideCount) || sideCount == 0)
        {
            yield break;
        }

        var sideOffset = GetSideOffset(counts, side);
        for (var i = 0; i < sideCount; i++)
        {
            var globalIndex = sideOffset + i;
            var isBreakSide = string.Equals(side, breakSide, StringComparison.OrdinalIgnoreCase);
            yield return new WallStackView(
                i,
                isBreakSide && i == breakIndex,
                isBreakSide && sideCount > 1 && i == breakGapIndex,
                IsConsumedStack(globalIndex, drawStartIndex, stacksConsumed));
        }
    }

    private static int GetSideOffset(IReadOnlyDictionary<string, int> counts, string side)
    {
        var offset = 0;
        foreach (var wallSide in WallSides)
        {
            if (string.Equals(wallSide, side, StringComparison.OrdinalIgnoreCase))
            {
                return offset;
            }

            if (counts.TryGetValue(wallSide, out var wallCount))
            {
                offset += wallCount;
            }
        }

        return 0;
    }

    private bool IsConsumedStack(int globalIndex, int drawStartIndex, int stacksConsumed)
    {
        if (stacksConsumed <= 0)
        {
            return false;
        }

        if (TotalWallStacks == 0)
        {
            return false;
        }

        var relativeIndex = (globalIndex - drawStartIndex + TotalWallStacks) % TotalWallStacks;
        return relativeIndex < stacksConsumed;
    }

    private string BuildWallStackTitle(string side, WallStackView stack)
    {
        if (stack.IsBreakMarker)
        {
            return $"{side} wall break marker";
        }

        if (stack.IsDepleted)
        {
            return $"{side} wall consumed stack {stack.Index + 1}";
        }

        return $"{side} wall stack {stack.Index + 1}";
    }

    private IEnumerable<string> BuildHiddenHand(int count)
    {
        for (var i = 0; i < count; i++)
        {
            yield return "🀫";
        }
    }

    private IEnumerable<string> BuildHiddenHandPreview(int count, int maxPreviewTiles)
    {
        return BuildHiddenHand(Math.Min(count, Math.Max(0, maxPreviewTiles)));
    }

