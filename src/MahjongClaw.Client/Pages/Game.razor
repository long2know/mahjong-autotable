@page "/game"
@using System.Linq
@using MahjongClaw.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject GameApiClient Api
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Game</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Game</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="lobby">Back to Lobby</a>
        <button class="btn btn-outline-primary" disabled>Invite</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(LiveStatus))
{
    <div class="alert alert-info py-2">@LiveStatus</div>
}

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                    <div>
                        <h5 class="card-title mb-1">@TableName</h5>
                        <div class="table-meta">
                            <span>Table ID: @TableCode</span>
                            <button class="btn btn-sm btn-outline-secondary" disabled>Copy</button>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @GetStatusBadge(GameStatus)">@GameStatus</span>
                        <span class="badge bg-dark-subtle text-dark">Wall: @WallRemaining tiles</span>
                    </div>
                </div>
                <div class="status-row mt-3">
                    <span class="badge text-bg-primary">Turn: @CurrentTurnName</span>
                    <span class="badge text-bg-secondary">Phase: @CurrentPhase</span>
                    <span class="badge text-bg-light">Round: @RoundWind</span>
                    <span class="badge text-bg-light">Hand: @HandNumber</span>
                    <span class="badge text-bg-light">Draws left: @DrawsRemaining</span>
                </div>

                <div class="wall-progress mt-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted small">Wall remaining</span>
                        <span class="text-muted small">@WallRemaining / @WallTotal</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Wall remaining" aria-valuenow="@WallRemaining" aria-valuemin="0" aria-valuemax="@WallTotal">
                        <div class="progress-bar" style="width: @WallPercent%"></div>
                    </div>
                </div>

                <div class="table-grid mt-4">
                    <div class="seat seat-north">
                        @RenderSeat(PlayerNorth)
                    </div>
                    <div class="seat seat-west">
                        @RenderSeat(PlayerWest)
                    </div>
                    <div class="seat seat-east">
                        @RenderSeat(PlayerEast)
                    </div>
                    <div class="seat seat-south">
                        @RenderSeat(PlayerSouth)
                    </div>
                    <div class="center-area">
                        <h6 class="text-uppercase text-muted">Discards</h6>
                        <div class="tile-row tile-row-wrap">
                            @foreach (var tile in CenterDiscards)
                            {
                                <Tile Label="@tile" />
                            }
                        </div>
                        <div class="mt-3 text-muted small">Current turn: <strong>@CurrentTurnName</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Game State</h5>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="state-label">Round Wind</div>
                        <div class="state-value">@RoundWind</div>
                    </div>
                    <div class="col-6">
                        <div class="state-label">Dealer</div>
                        <div class="state-value">@CurrentDealerName</div>
                    </div>
                    <div class="col-6">
                        <div class="state-label">Hand #</div>
                        <div class="state-value">@HandNumber</div>
                    </div>
                    <div class="col-6">
                        <div class="state-label">Wall Remaining</div>
                        <div class="state-value">@WallRemaining</div>
                    </div>
                </div>
                <div class="score-list mt-3">
                    @foreach (var player in Scoreboard)
                    {
                        <div class="score-item">
                            <span class="fw-semibold">@player.Name</span>
                            <span class="text-muted">@player.Score pts</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Seat Summary</h5>
                <div class="seat-summary">
                    @foreach (var seat in Seats)
                    {
                        <div class="seat-summary-item">
                            <div>
                                <div class="fw-semibold">@seat.Wind</div>
                                <div class="small text-muted">@seat.Player</div>
                            </div>
                            <div class="text-end">
                                <div class="badge text-bg-light">@seat.Score pts</div>
                                @if (seat.IsDealer)
                                {
                                    <div class="badge text-bg-warning ms-1">Dealer</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="card-title mb-0">Your Hand</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-primary">@PlayerSouth.Seat</span>
                        <span class="badge text-bg-light">@PlayerSouth.Hand.Count tiles</span>
                    </div>
                </div>
                <div class="tile-row mt-3">
                    @foreach (var tile in PlayerSouth.Hand)
                    {
                        <Tile Label="@tile" IsHighlighted="@tile.StartsWith("🀄")" />
                    }
                </div>
                <p class="text-muted small mt-3 mb-0">Tap a tile to discard once wired to actions.</p>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Recent Actions</h5>
                <ul class="timeline">
                    @foreach (var entry in RecentActions)
                    {
                        <li>
                            <div class="timeline-time">@entry.Timestamp</div>
                            <div class="timeline-text">@entry.Description</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Melds on Table</h5>
                <div class="meld-list">
                    @foreach (var meld in Melds)
                    {
                        <div class="meld-item">
                            <div class="fw-semibold">@meld.Player</div>
                            <div class="text-muted small">@meld.Type</div>
                            <div class="meld-tiles mt-2">
                                @foreach (var tile in meld.Tiles)
                                {
                                    <Tile Label="@tile" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-2">Actions</h5>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary">Draw</button>
                    <button class="btn btn-outline-secondary">Discard</button>
                    <button class="btn btn-outline-success">Declare Win</button>
                    <button class="btn btn-outline-warning">Meld</button>
                </div>
                <p class="text-muted small mt-3 mb-0">Buttons are currently mocked for layout only.</p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? GameId { get; set; }
    [SupplyParameterFromQuery] public Guid? PlayerId { get; set; }

    private static readonly MockGameState MockState = new();
    private static readonly string[] SeatOrder = ["East", "South", "West", "North"];

    private HubConnection? _hub;
    private readonly CancellationTokenSource _disposeCts = new();
    private GameApiClient.GameStateResponse? _liveState;
    private string? LiveStatus;

    private int WallTotal => MockState.WallTotal;
    private int WallRemaining => _liveState is null ? MockState.WallRemaining : Math.Max(0, WallTotal - _liveState.TilesInPlay);
    private string WallPercent => ((WallRemaining / (double)WallTotal) * 100).ToString("0");
    private int DrawsRemaining => _liveState is null ? MockState.DrawsRemaining : Math.Max(0, WallRemaining / 4);
    private string RoundWind => _liveState is null ? MockState.RoundWind : GetRoundWind(_liveState.Round);
    private int HandNumber => _liveState?.Round ?? MockState.HandNumber;
    private string TableName => GameId is null ? MockState.TableName : $"Game {GameId}";
    private string TableCode => GameId?.ToString()[..8] ?? MockState.TableCode;
    private string GameStatus => _liveState?.Status ?? MockState.GameStatus;
    private string CurrentPhase => _liveState?.Status ?? "Discard";
    private string CurrentTurnName => ResolvePlayerName(_liveState?.CurrentPlayerId, fallback: PlayerEast.Name);
    private string CurrentDealerName => ResolvePlayerName(_liveState?.DealerId, fallback: PlayerEast.Name);

    private PlayerView PlayerNorth => GetPlayerView("North", MockState.PlayerNorth);
    private PlayerView PlayerWest => GetPlayerView("West", MockState.PlayerWest);
    private PlayerView PlayerEast => GetPlayerView("East", MockState.PlayerEast);
    private PlayerView PlayerSouth => GetPlayerView("South", MockState.PlayerSouth);

    private IReadOnlyList<string> CenterDiscards => MockState.CenterDiscards;
    private IReadOnlyList<(string Name, int Score)> Scoreboard =>
        _liveState?.Players?.Select(p => (p.Name, p.Score)).ToList() ?? MockState.Scoreboard;
    private IReadOnlyList<(string Timestamp, string Description)> RecentActions =>
        _liveState is null
            ? MockState.RecentActions
            :
            [
                ($"{DateTime.Now:t}", $"Status: {_liveState.Status}"),
                ($"{DateTime.Now:t}", $"Players: {_liveState.Players.Count}"),
                ($"{DateTime.Now:t}", $"Discards: {_liveState.DiscardCount}")
            ];
    private IReadOnlyList<(string Player, string Type, List<string> Tiles)> Melds =>
        _liveState is null
            ? MockState.Melds
            :
            [
                ("Table", $"Meld count: {_liveState.MeldCount}", new List<string>()),
                ("Table", $"Tiles in play: {_liveState.TilesInPlay}", new List<string>())
            ];
    private IReadOnlyList<(string Wind, string Player, int Score, bool IsDealer)> Seats =>
        _liveState?.Players is null
            ? MockState.Seats
            : SeatOrder.Select(seat =>
            {
                var player = _liveState.Players.FirstOrDefault(p => string.Equals(p.Seat, seat, StringComparison.OrdinalIgnoreCase));
                return (
                    Wind: seat,
                    Player: player?.Name ?? "Open",
                    Score: player?.Score ?? 0,
                    IsDealer: player is not null && _liveState.DealerId == player.Id
                );
            }).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (GameId is null)
        {
            LiveStatus = "Using mock state (no gameId query parameter).";
            return;
        }

        await RefreshLiveStateAsync();
        await ConnectHubAsync(GameId.Value);
    }

    private async Task ConnectHubAsync(Guid gameId)
    {
        var hubUri = Navigation.ToAbsoluteUri("/hubs/game");

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri)
            .WithAutomaticReconnect()
            .Build();

        _hub.On<object>("PlayerJoined", _ => _ = RefreshFromEventAsync("Player joined"));
        _hub.On<object>("GameStarted", _ => _ = RefreshFromEventAsync("Game started"));
        _hub.On<object>("TileDrawn", _ => _ = RefreshFromEventAsync("Tile drawn"));
        _hub.On<object>("TileDiscarded", _ => _ = RefreshFromEventAsync("Tile discarded"));
        _hub.On<object>("MeldDeclared", _ => _ = RefreshFromEventAsync("Meld declared"));
        _hub.On<object>("GameWon", _ => _ = RefreshFromEventAsync("Game won"));
        _hub.On<object>("GameStateUpdated", _ => _ = RefreshFromEventAsync("State updated"));

        _hub.Reconnecting += error =>
        {
            LiveStatus = $"Reconnecting to live updates{(error is null ? string.Empty : $": {error.Message}")}";
            return InvokeAsync(StateHasChanged);
        };

        _hub.Reconnected += async _ =>
        {
            LiveStatus = "Live updates reconnected.";
            await RefreshLiveStateAsync();
        };

        _hub.Closed += error =>
        {
            if (_disposeCts.IsCancellationRequested)
            {
                return Task.CompletedTask;
            }

            LiveStatus = $"Live updates disconnected{(error is null ? "." : $": {error.Message}")}";
            return InvokeAsync(StateHasChanged);
        };

        await _hub.StartAsync(_disposeCts.Token);
        await _hub.SendAsync("JoinGame", gameId.ToString(), _disposeCts.Token);

        LiveStatus = $"Connected to live updates for game {gameId}.";
    }

    private Task RefreshFromEventAsync(string eventName)
    {
        LiveStatus = $"Event received: {eventName}. Refreshing live state...";
        return RefreshLiveStateAsync();
    }

    private async Task RefreshLiveStateAsync()
    {
        if (GameId is null || _disposeCts.IsCancellationRequested)
        {
            return;
        }

        try
        {
            _liveState = await Api.GetGameStateAsync(GameId.Value, _disposeCts.Token);
            LiveStatus = $"Live state refreshed at {DateTime.Now:T}. Status: {_liveState.Status}";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            // ignore shutdown cancellation
        }
        catch (Exception ex)
        {
            LiveStatus = $"Live refresh failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();

        if (_hub is null)
        {
            _disposeCts.Dispose();
            return;
        }

        try
        {
            if (GameId is not null)
            {
                await _hub.SendAsync("LeaveGame", GameId.Value.ToString());
            }

            await _hub.DisposeAsync();
        }
        catch
        {
            // ignore shutdown errors in UI teardown
        }
        finally
        {
            _disposeCts.Dispose();
        }
    }

    private string ResolvePlayerName(Guid? playerId, string fallback)
    {
        if (playerId is null || _liveState?.Players is null)
        {
            return fallback;
        }

        return _liveState.Players.FirstOrDefault(player => player.Id == playerId.Value)?.Name ?? fallback;
    }

    private PlayerView GetPlayerView(string seat, PlayerView fallback)
    {
        if (_liveState?.Players is null)
        {
            return fallback;
        }

        var player = _liveState.Players.FirstOrDefault(p => string.Equals(p.Seat, seat, StringComparison.OrdinalIgnoreCase));
        if (player is null)
        {
            return fallback with { Name = "Open", Score = 0, IsDealer = false, IsCurrent = false, HandCount = 0 };
        }

        return fallback with
        {
            Name = player.Name,
            Seat = player.Seat,
            Score = player.Score,
            IsDealer = _liveState.DealerId == player.Id,
            IsCurrent = _liveState.CurrentPlayerId == player.Id
        };
    }

    private static string GetRoundWind(int round) => round switch
    {
        <= 4 => "East",
        <= 8 => "South",
        <= 12 => "West",
        _ => "North"
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "Waiting" => "text-bg-info",
        "In Progress" => "text-bg-success",
        "Paused" => "text-bg-warning",
        "Complete" => "text-bg-secondary",
        _ => "text-bg-primary"
    };

    private IEnumerable<string> BuildHiddenHand(int count)
    {
        for (var i = 0; i < count; i++)
        {
            yield return "🀫";
        }
    }

    private RenderFragment RenderSeat(PlayerView player) => @<div class="seat-card">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="fw-semibold">@player.Name</div>
                <div class="small text-muted">@player.Seat</div>
            </div>
            <div class="text-end">
                <div class="badge text-bg-light">@player.Score pts</div>
                @if (player.IsDealer)
                {
                    <div class="badge text-bg-warning ms-1">Dealer</div>
                }
                @if (player.IsCurrent)
                {
                    <div class="badge text-bg-success ms-1">Turn</div>
                }
            </div>
        </div>
        <div class="tile-row tile-row-wrap mt-2">
            @foreach (var tile in player.Discards)
            {
                <Tile Label="@tile" />
            }
        </div>
        <div class="tile-row tile-row-wrap mt-2">
            @foreach (var tile in BuildHiddenHand(player.HandCount))
            {
                <Tile Label="@tile" IsFaceDown="true" />
            }
        </div>
    </div>;

    private record PlayerView(string Seat, string Name, int Score, List<string> Discards, List<string> Hand, int HandCount, bool IsDealer, bool IsCurrent);

    private record MockGameState
    {
        public string TableName { get; init; } = "Golden Dragons";
        public string TableCode { get; init; } = "GD-4821";
        public string GameStatus { get; init; } = "In Progress";
        public int WallRemaining { get; init; } = 70;
        public int WallTotal { get; init; } = 136;
        public int DrawsRemaining { get; init; } = 10;
        public string RoundWind { get; init; } = "East";
        public int HandNumber { get; init; } = 3;

        public PlayerView PlayerNorth { get; init; } = new("North", "Kai", 1200, new() { "🀐", "🀑", "🀒" }, new(), 12, true, false);
        public PlayerView PlayerWest { get; init; } = new("West", "Mina", 800, new() { "🀀", "🀁" }, new(), 11, false, false);
        public PlayerView PlayerEast { get; init; } = new("East", "Jun", 1340, new() { "🀙", "🀚", "🀛", "🀜" }, new(), 13, false, true);
        public PlayerView PlayerSouth { get; init; } = new("South", "You", 920, new(), new()
        {
            "🀄 5 Bamboo", "🀅 7 Dots", "🀀 East", "🀂 South", "🀆 9 Dots", "🀐 1 Character",
            "🀓 4 Character", "🀙 1 Bamboo", "🀚 2 Bamboo", "🀛 3 Bamboo", "🀝 5 Bamboo",
            "🀞 6 Bamboo", "🀟 7 Bamboo"
        }, 13, false, false);

        public IReadOnlyList<string> CenterDiscards { get; init; } = new[]
        {
            "🀀", "🀁", "🀂", "🀃", "🀅", "🀆", "🀈", "🀐", "🀑", "🀒"
        };

        public IReadOnlyList<(string Name, int Score)> Scoreboard { get; init; } = new[]
        {
            ("Jun", 1340),
            ("Kai", 1200),
            ("You", 920),
            ("Mina", 800)
        };

        public IReadOnlyList<(string Timestamp, string Description)> RecentActions { get; init; } = new[]
        {
            ("19:12", "Jun drew a tile."),
            ("19:11", "Mina discarded 🀅 7 Dots."),
            ("19:10", "You declared Pung on 🀀 East."),
            ("19:09", "Kai discarded 🀓 4 Character.")
        };

        public IReadOnlyList<(string Player, string Type, List<string> Tiles)> Melds { get; init; } = new[]
        {
            ("You", "Pung", new List<string> { "🀀", "🀀", "🀀" }),
            ("Jun", "Chow", new List<string> { "🀙", "🀚", "🀛" }),
            ("Kai", "Kong", new List<string> { "🀅", "🀅", "🀅", "🀅" })
        };

        public IReadOnlyList<(string Wind, string Player, int Score, bool IsDealer)> Seats { get; init; } = new[]
        {
            ("East", "Jun", 1340, true),
            ("South", "You", 920, false),
            ("West", "Mina", 800, false),
            ("North", "Kai", 1200, false)
        };
    }
}
