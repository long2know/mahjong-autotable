@page "/game"
@using System.Linq
@using MahjongClaw.Client.Services
@using MahjongClaw.Domain.Rules
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject GameApiClient Api
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Game</PageTitle>

<div class="game-3d-refine">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h1 class="mb-0">Game</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="lobby">Back to Lobby</a>
            <button class="btn btn-outline-primary" disabled>Invite</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(LiveStatus))
    {
        <div class="alert alert-info py-2">@LiveStatus</div>
    }

    <div class="table-action-toolbar mb-3" aria-label="Table action toolbar">
        <button class="btn btn-success btn-sm" type="button">Feedback</button>
        <button class="btn btn-success btn-sm" type="button" disabled>Share</button>
        <button class="btn btn-success btn-sm" type="button" disabled>More</button>
    </div>

    <div class="row g-4">
    <div class="col-12 col-xl-9">
        <div class="card h-100 game-board-shell">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                    <div>
                        <h5 class="card-title mb-1">@TableName</h5>
                        <div class="table-meta">
                            <span>Table ID: @TableCode</span>
                            <button class="btn btn-sm btn-outline-secondary" disabled>Copy</button>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @GetStatusBadge(GameStatus)">@GameStatus</span>
                        <span class="badge bg-dark-subtle text-dark">Wall: @WallRemaining tiles</span>
                    </div>
                </div>
                <div class="status-row mt-3">
                    <span class="badge text-bg-primary">Turn: @CurrentTurnName</span>
                    <span class="badge text-bg-secondary">Phase: @CurrentPhase</span>
                    <span class="badge text-bg-light">Round: @RoundWind</span>
                    <span class="badge text-bg-light">Hand: @HandNumber</span>
                    <span class="badge text-bg-light">Draws left: @DrawsRemaining</span>
                    <span class="badge text-bg-light">Ruleset: @RulesetLabel</span>
                </div>
                <div class="text-muted small mt-2">@RulesetDescription</div>

                <div class="wall-progress mt-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted small">Wall remaining</span>
                        <span class="text-muted small">@WallRemaining / @WallTotal</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Wall remaining" aria-valuenow="@WallRemaining" aria-valuemin="0" aria-valuemax="@WallTotal">
                        <div class="progress-bar" style="width: @WallPercent%"></div>
                    </div>
                </div>

                <div class="table-surface mt-4">
                    <div class="table-grid">
                        <div class="seat seat-north">
                            @RenderSeat(PlayerNorth)
                        </div>
                        <div class="seat seat-west">
                            @RenderSeat(PlayerWest)
                        </div>
                        <div class="seat seat-east">
                            @RenderSeat(PlayerEast)
                        </div>
                        <div class="seat seat-south">
                            @RenderSeat(PlayerSouth)
                        </div>
                        <div class="center-area">
                            <div class="table-indicator" aria-label="Round and hand indicator">
                                <div class="indicator-wind">@RoundWind Round</div>
                                <div class="indicator-hand">Hand @HandNumber</div>
                            </div>
                            <div class="seat-anchors" aria-label="Seat anchors">
                                <span class='@BuildSeatAnchorClass("North")'>North</span>
                                <span class='@BuildSeatAnchorClass("East")'>East</span>
                                <span class='@BuildSeatAnchorClass("South")'>South</span>
                                <span class='@BuildSeatAnchorClass("West")'>West</span>
                            </div>
                            <div class="table-compass" aria-label="Table compass wind markers">
                                <span class='@BuildCompassMarkerClass("North")'>N</span>
                                <span class='@BuildCompassMarkerClass("East")'>E</span>
                                <span class='@BuildCompassMarkerClass("South")'>S</span>
                                <span class='@BuildCompassMarkerClass("West")'>W</span>
                            </div>
                            <div class="physical-wall" aria-label="Mahjong wall preview">
                                <span class="wall-corner wall-corner-nw" aria-hidden="true"></span>
                                <span class="wall-corner wall-corner-ne" aria-hidden="true"></span>
                                <span class="wall-corner wall-corner-se" aria-hidden="true"></span>
                                <span class="wall-corner wall-corner-sw" aria-hidden="true"></span>
                                <div class="wall-side wall-top @(IsDealerSide("North") ? "wall-side-dealer" : string.Empty)">
                                    <span class="wall-side-label">North wall</span>
                                    @foreach (var stack in BuildWallSide("North"))
                                    {
                                        <div class="wall-stack @(stack.IsBreakMarker ? "wall-stack-break" : string.Empty) @(stack.IsAfterBreak ? "wall-stack-break-gap" : string.Empty) @(stack.IsDepleted ? "wall-stack-depleted" : string.Empty)" title="@BuildWallStackTitle("North", stack)"></div>
                                    }
                                </div>
                                <div class="wall-side wall-right @(IsDealerSide("East") ? "wall-side-dealer" : string.Empty)">
                                    <span class="wall-side-label">East wall</span>
                                    @foreach (var stack in BuildWallSide("East"))
                                    {
                                        <div class="wall-stack @(stack.IsBreakMarker ? "wall-stack-break" : string.Empty) @(stack.IsAfterBreak ? "wall-stack-break-gap" : string.Empty) @(stack.IsDepleted ? "wall-stack-depleted" : string.Empty)" title="@BuildWallStackTitle("East", stack)"></div>
                                    }
                                </div>
                                <div class="wall-side wall-bottom @(IsDealerSide("South") ? "wall-side-dealer" : string.Empty)">
                                    <span class="wall-side-label">South wall</span>
                                    @foreach (var stack in BuildWallSide("South"))
                                    {
                                        <div class="wall-stack @(stack.IsBreakMarker ? "wall-stack-break" : string.Empty) @(stack.IsAfterBreak ? "wall-stack-break-gap" : string.Empty) @(stack.IsDepleted ? "wall-stack-depleted" : string.Empty)" title="@BuildWallStackTitle("South", stack)"></div>
                                    }
                                </div>
                                <div class="wall-side wall-left @(IsDealerSide("West") ? "wall-side-dealer" : string.Empty)">
                                    <span class="wall-side-label">West wall</span>
                                    @foreach (var stack in BuildWallSide("West"))
                                    {
                                        <div class="wall-stack @(stack.IsBreakMarker ? "wall-stack-break" : string.Empty) @(stack.IsAfterBreak ? "wall-stack-break-gap" : string.Empty) @(stack.IsDepleted ? "wall-stack-depleted" : string.Empty)" title="@BuildWallStackTitle("West", stack)"></div>
                                    }
                                </div>
                            </div>
                            <div class="wall-legend" aria-label="Wall legend">
                                <span class="wall-legend-item wall-legend-item-break"><span class="wall-stack wall-stack-break"></span> break marker</span>
                                <span class="wall-legend-item wall-legend-item-depleted"><span class="wall-stack wall-stack-depleted"></span> consumed stack</span>
                                <span class="wall-legend-item wall-legend-item-dealer"><span class="wall-stack wall-stack-dealer"></span> dealer wall</span>
                                <span class="wall-legend-item wall-legend-item-remaining"><strong>@WallRemaining</strong> tiles remain</span>
                            </div>
                            <h6 class="discard-lane-title text-uppercase text-muted mt-3">Discards</h6>
                            <div class="discard-lane" aria-label="Center discard lane">
                                @foreach (var tile in CenterDiscards)
                                {
                                    <Tile Label="@tile" ExtraClass="tile-discard" />
                                }
                            </div>
                            <div class="center-turn-label mt-3 text-muted small">Current turn: <strong>@CurrentTurnName</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-3 game-side-panel">
        <div class="card mb-4 leaderboard-panel">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                    <h5 class="card-title mb-0">Weekly Leaderboard</h5>
                    <span class="leaderboard-sync-label">Update every hour</span>
                </div>
                <div class="leaderboard-header-row">
                    <span>Player</span>
                    <span>Won</span>
                </div>
                <div class="leaderboard-list">
                    @for (var i = 0; i < Scoreboard.Count; i++)
                    {
                        var player = Scoreboard[i];
                        <div class="leaderboard-item">
                            <span class="leaderboard-player">
                                <span class="leaderboard-rank">#@(i + 1)</span>
                                <span class="fw-semibold">@player.Name</span>
                            </span>
                            <span class="leaderboard-value">@Math.Max(0, player.Score / 12)</span>
                        </div>
                    }
                </div>
                <div class="leaderboard-note">Your stats are unsaved! <a href="lobby">Save now.</a></div>
                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <div class="state-label">Round</div>
                        <div class="state-value">@RoundWind</div>
                    </div>
                    <div class="col-6">
                        <div class="state-label">Dealer</div>
                        <div class="state-value">@CurrentDealerName</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mb-4 seat-summary-panel">
            <div class="card-body">
                <h5 class="card-title mb-2">Seat Summary</h5>
                <div class="seat-summary">
                    @foreach (var seat in Seats)
                    {
                        <div class="@BuildSeatSummaryItemClass(seat.Wind)">
                            <div class="seat-summary-meta">
                                <div class="fw-semibold seat-summary-wind">@seat.Wind</div>
                                <div class="small text-muted seat-summary-player">@seat.Player</div>
                            </div>
                            <div class="text-end seat-summary-score-stack">
                                <div class="badge text-bg-light seat-summary-badge seat-summary-badge-score">@seat.Score pts</div>
                                @if (seat.IsDealer)
                                {
                                    <div class="badge text-bg-warning ms-1 seat-summary-badge seat-summary-badge-dealer">Dealer</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card mb-4 your-hand-panel">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="card-title mb-0">Your Hand</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-primary">@ViewerHandPlayer.Seat</span>
                        <span class="badge text-bg-light">@ViewerHandTiles.Count tiles</span>
                    </div>
                </div>

                @if (_liveState is not null && ViewerHandTiles.Count == 0)
                {
                    <p class="text-muted small mt-3 mb-0">Join as a player to view and select your hand tiles.</p>
                }
                else
                {
                    <div class="tile-row mt-3 seat-tiles seat-@ViewerHandPlayer.Seat.ToLowerInvariant() hand-tile-selection">
                    @foreach (var tile in ViewerHandTiles)
                    {
                        var isSelected = tile.Id is Guid tileId && IsMeldTileSelected(tileId);
                        <button type="button"
                                class="hand-tile-button @(isSelected ? "hand-tile-button-selected" : string.Empty)"
                                @onclick="() => ToggleMeldTileSelection(tile.Id)"
                                disabled="@(tile.Id is null || !CanMeld)">
                            <Tile Label="@tile.Label" IsHighlighted="@isSelected" />
                        </button>
                    }
                    </div>
                    <p class="text-muted small mt-3 mb-0">Select @RequiredMeldTileCount tile(s) and declare @SelectedMeldType.ToLowerInvariant() when meld is legal.</p>
                }
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Recent Actions</h5>
                <ul class="timeline">
                    @foreach (var entry in RecentActions)
                    {
                        <li>
                            <div class="timeline-time">@entry.Timestamp</div>
                            <div class="timeline-text">@entry.Description</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">Melds on Table</h5>
                @if (Melds.Count == 0)
                {
                    <p class="text-muted small mb-0">No melds declared in this hand yet.</p>
                }
                else
                {
                    <div class="meld-list">
                        @foreach (var meld in Melds)
                        {
                            <div class="meld-item">
                                <div class="fw-semibold">@meld.Player</div>
                                <div class="text-muted small">@meld.Type</div>
                                <div class="meld-tiles mt-2 seat-tiles seat-south">
                                    @foreach (var tile in meld.Tiles)
                                    {
                                        <Tile Label="@tile" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="card actions-panel">
            <div class="card-body">
                <h5 class="card-title mb-2">Actions</h5>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary" @onclick="DrawTileAsync" disabled="@(!CanDraw)">Draw</button>
                    <button class="btn btn-outline-secondary" @onclick="DiscardLastDrawnTileAsync" disabled="@(!CanDiscard)" title="Discards the most recently drawn tile for this player.">Discard Last Draw</button>
                    <button class="btn btn-outline-warning" @onclick="DeclareMeldAsync" disabled="@(!CanDeclareSelectedMeld)">Declare @SelectedMeldType</button>
                    <button class="btn btn-outline-success" @onclick="DeclareWinAsync" disabled="@(!CanDeclareWin)">Declare Win</button>
                </div>
                <div class="claim-panel mt-3">
                    <div class="small fw-semibold">Claim Decision</div>
                    <div class="claim-priority-text">Priority: Win &gt; Kong &gt; Pung &gt; Chow. Claim window closes once the server resolves the next action.</div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button class="btn btn-sm btn-outline-light" type="button" @onclick='() => SetMeldType("Chow")' disabled="@(!CanMeld)">Chow</button>
                        <button class="btn btn-sm btn-outline-light" type="button" @onclick='() => SetMeldType("Pung")' disabled="@(!CanMeld)">Pung</button>
                        <button class="btn btn-sm btn-outline-light" type="button" @onclick='() => SetMeldType("Kong")' disabled="@(!CanMeld)">Kong</button>
                        <button class="btn btn-sm btn-outline-light" type="button" @onclick="SetDiscardWinClaim" disabled="@(!CanDeclareWin || _liveState?.LastDiscardPlayerId is null)">Win</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="PassClaimSelection" disabled="@(!HasClaimActions)">Pass</button>
                    </div>
                </div>

                <div class="win-options mt-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" id="win-self-draw" type="checkbox" checked="@_winIsSelfDraw" @onchange="OnWinSelfDrawChanged" />
                        <label class="form-check-label" for="win-self-draw">Self draw win</label>
                    </div>
                    @if (!_winIsSelfDraw)
                    {
                        <label class="form-label form-label-sm mt-2 mb-1" for="win-discarder-select">Discarder</label>
                        <select id="win-discarder-select" class="form-select form-select-sm" value="@(_winDiscarderPlayerId?.ToString() ?? string.Empty)" @onchange="HandleDiscarderSelectionChanged">
                            <option value="">Select discarder</option>
                            @foreach (var player in AvailableDiscarderOptions)
                            {
                                <option value="@player.Id">@player.Name (@player.Seat)</option>
                            }
                        </select>
                    }
                    <div class="row g-2 mt-1">
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1" for="win-bird-rank">Bird rank</label>
                            <input id="win-bird-rank" type="number" class="form-control form-control-sm" min="1" max="9" placeholder="1-9 optional" value="@_winBirdRankText" @onchange="HandleBirdRankChanged" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="form-check mb-1">
                                <input class="form-check-input" id="win-multiple" type="checkbox" @bind="_winIsMultipleWin" disabled="@_winIsSelfDraw" />
                                <label class="form-check-label small" for="win-multiple">Multiple win (discard)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">Draw/discard/meld/win actions now use live APIs when gameId + playerId are present.</p>
            </div>
        </div>
        @if (_latestWin is not null)
        {
            <div class="card mb-4 settlement-panel">
                <div class="card-body">
                    <h5 class="card-title mb-2">Latest Settlement</h5>
                    <div class="small mb-2">
                        Winner: <strong>@ResolvePlayerName(_latestWin.PlayerId, _latestWin.PlayerId.ToString()[..8])</strong>
                        @if (_latestWin.BirdSeat is not null)
                        {
                            <span> • Bird seat: <strong>@_latestWin.BirdSeat</strong></span>
                        }
                        @if (_latestWin.NextRound is not null)
                        {
                            <span> • Next round: <strong>@_latestWin.NextRound</strong></span>
                        }
                    </div>

                    @if (_latestWin.ChangshaWinTypes is { Count: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var winType in _latestWin.ChangshaWinTypes)
                            {
                                <span class="badge text-bg-light">@winType</span>
                            }
                        </div>
                    }

                    @if (_latestWin.ScoreDeltas is { Count: > 0 })
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0 settlement-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Player</th>
                                        <th scope="col" class="text-end">Delta</th>
                                        <th scope="col" class="text-end">New score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var delta in _latestWin.ScoreDeltas.OrderByDescending(item => item.Delta))
                                    {
                                        <tr>
                                            <td>@ResolvePlayerName(delta.PlayerId, delta.PlayerId.ToString()[..8])</td>
                                            <td class="text-end @(delta.Delta >= 0 ? "text-success" : "text-danger")">@((delta.Delta >= 0 ? "+" : string.Empty) + delta.Delta)</td>
                                            <td class="text-end">@delta.NewScore</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? GameId { get; set; }
    [SupplyParameterFromQuery] public Guid? PlayerId { get; set; }

    private static readonly MockGameState MockState = new();
    private static readonly string[] SeatOrder = ["East", "South", "West", "North"];

    private HubConnection? _hub;
    private readonly CancellationTokenSource _disposeCts = new();
    private GameApiClient.GameStateResponse? _liveState;
    private readonly List<(string Timestamp, string Description)> _liveEvents = [];
    private Guid? _lastDrawnTileId;
    private readonly HashSet<Guid> _selectedMeldTileIds = [];
    private string _selectedMeldType = "Chow";
    private bool _winIsSelfDraw = true;
    private Guid? _winDiscarderPlayerId;
    private string _winBirdRankText = string.Empty;
    private bool _winIsMultipleWin;
    private GameApiClient.WinResponse? _latestWin;
    private bool _botTurnInFlight;
    private string? LiveStatus;

    private bool CanDraw =>
        GameId is not null &&
        PlayerId is not null &&
        _liveState is not null &&
        IsLiveGameActive(_liveState.Status) &&
        _liveState.CurrentPlayerId == PlayerId &&
        HasLegalAction("Draw");

    private bool CanDiscard =>
        GameId is not null &&
        PlayerId is not null &&
        _liveState is not null &&
        IsLiveGameActive(_liveState.Status) &&
        _liveState.CurrentPlayerId == PlayerId &&
        _lastDrawnTileId is not null &&
        HasLegalAction("Discard");

    private bool CanDeclareWin =>
        GameId is not null &&
        PlayerId is not null &&
        _liveState is not null &&
        IsLiveGameActive(_liveState.Status) &&
        _liveState.CurrentPlayerId == PlayerId &&
        HasLegalAction("Win");

    private bool CanMeld =>
        GameId is not null &&
        PlayerId is not null &&
        _liveState is not null &&
        IsLiveGameActive(_liveState.Status) &&
        _liveState.CurrentPlayerId == PlayerId &&
        HasLegalAction("Meld");

    private bool HasClaimActions => CanMeld || CanDeclareWin;
    private string SelectedMeldType => _selectedMeldType;
    private int RequiredMeldTileCount => string.Equals(_selectedMeldType, "Kong", StringComparison.OrdinalIgnoreCase) ? 4 : 3;
    private bool CanDeclareSelectedMeld => CanMeld && _selectedMeldTileIds.Count == RequiredMeldTileCount;
    private IReadOnlyList<GameApiClient.PlayerSummary> AvailableDiscarderOptions => _liveState?.Players
        .Where(player => PlayerId is null || player.Id != PlayerId.Value)
        .OrderBy(player => player.Seat)
        .ToList() ?? [];

    private int WallTotal => _liveState is null
        ? RulesetHelpers.GetWallTotal(MockState.Ruleset)
        : _liveState.WallTotal;
    private int WallRemaining => _liveState is null ? MockState.WallRemaining : Math.Max(0, WallTotal - _liveState.TilesInPlay);
    private string WallPercent => ((WallRemaining / (double)WallTotal) * 100).ToString("0");
    private int DrawsRemaining => _liveState is null ? MockState.DrawsRemaining : Math.Max(0, WallRemaining / 4);
    private string RoundWind => _liveState is null ? MockState.RoundWind : GetRoundWind(_liveState.Round);
    private int HandNumber => _liveState?.Round ?? MockState.HandNumber;
    private string TableName => GameId is null ? MockState.TableName : $"Game {GameId}";
    private string TableCode => GameId?.ToString()[..8] ?? MockState.TableCode;
    private string GameStatus => NormalizeGameStatus(_liveState?.Status) ?? MockState.GameStatus;
    private string RulesetLabel => _liveState is null
        ? RulesetHelpers.FormatLabel(MockState.Ruleset)
        : RulesetHelpers.FormatLabel(_liveState.Ruleset);
    private string RulesetDescription => _liveState is null
        ? RulesetHelpers.GetDescription(MockState.Ruleset)
        : RulesetHelpers.GetDescription(_liveState.Ruleset);
    private string CurrentPhase => _liveState is null ? "Discard" : NormalizeTurnPhase(_liveState.TurnPhase, _liveState.Status);
    private string CurrentTurnName => ResolvePlayerName(_liveState?.CurrentPlayerId, fallback: PlayerEast.Name);
    private string CurrentTurnSeat => ResolveSeat(_liveState?.CurrentPlayerId, fallback: "East");
    private string CurrentDealerName => _liveState is null
        ? MockState.Seats.FirstOrDefault(seat => seat.IsDealer).Player ?? PlayerEast.Name
        : ResolvePlayerName(_liveState.DealerId, fallback: PlayerEast.Name);
    private string CurrentDealerSeat => _liveState is null
        ? MockState.Seats.FirstOrDefault(seat => seat.IsDealer).Wind ?? "East"
        : ResolveSeat(_liveState.DealerId, fallback: "East");

    private PlayerView PlayerNorth => GetPlayerView("North", MockState.PlayerNorth);
    private PlayerView PlayerWest => GetPlayerView("West", MockState.PlayerWest);
    private PlayerView PlayerEast => GetPlayerView("East", MockState.PlayerEast);
    private PlayerView PlayerSouth => GetPlayerView("South", MockState.PlayerSouth);
    private PlayerView ViewerHandPlayer => GetViewerHandPlayerView();
    private IReadOnlyList<HandTileView> ViewerHandTiles => _liveState is null
        ? MockState.PlayerSouth.Hand.Select(label => new HandTileView(null, label)).ToList()
        : _liveState.ViewerHand.Select(tile => new HandTileView(tile.Id, tile.Label)).ToList();

    private IReadOnlyList<string> CenterDiscards => _liveState is null
        ? MockState.CenterDiscards
        : _liveState.Discards
            .OrderBy(discard => discard.Sequence)
            .Select(discard => discard.TileLabel)
            .ToList();
    private IReadOnlyList<(string Name, int Score)> Scoreboard =>
        _liveState?.Players?.Select(p => (p.Name, p.Score)).ToList() ?? MockState.Scoreboard;
    private IReadOnlyList<(string Timestamp, string Description)> RecentActions =>
        _liveState is null
            ? MockState.RecentActions
            : _liveEvents.Count > 0
                ? _liveEvents
                :
                [
                    ($"{DateTime.Now:t}", $"Status: {_liveState.Status}"),
                    ($"{DateTime.Now:t}", $"Current turn: {ResolvePlayerName(_liveState.CurrentPlayerId, "Unknown")}"),
                    ($"{DateTime.Now:t}", $"Discards: {_liveState.Discards.Count}")
                ];
    private IReadOnlyList<(string Player, string Type, List<string> Tiles)> Melds =>
        _liveState is null
            ? MockState.Melds
            : _liveState.Melds
                .Select(meld => (
                    ResolvePlayerName(meld.PlayerId, meld.PlayerId.ToString()[..8]),
                    meld.Type,
                    meld.Tiles.Select(tile => tile.Label).ToList()))
                .ToList();
    private IReadOnlyList<(string Wind, string Player, int Score, bool IsDealer)> Seats =>
        _liveState?.Players is null
            ? MockState.Seats
            : SeatOrder.Select(seat =>
            {
                var player = _liveState.Players.FirstOrDefault(p => string.Equals(p.Seat, seat, StringComparison.OrdinalIgnoreCase));
                return (
                    Wind: seat,
                    Player: player?.Name ?? "Open",
                    Score: player?.Score ?? 0,
                    IsDealer: player is not null && _liveState.DealerId == player.Id
                );
            }).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (GameId is null)
        {
            LiveStatus = "Using mock state (no gameId query parameter).";
            return;
        }

        await RefreshLiveStateAsync();
        await ConnectHubAsync(GameId.Value);
    }

    private async Task ConnectHubAsync(Guid gameId)
    {
        var hubUri = Navigation.ToAbsoluteUri("/hubs/game");

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri)
            .WithAutomaticReconnect()
            .Build();

        RegisterPlayerJoinedHandler("PlayerJoined");
        RegisterGameStartedHandler("GameStarted");
        RegisterTileDrawnHandler("TileDrawn");
        RegisterTileDiscardedHandler("TileDiscarded");
        RegisterMeldDeclaredHandler("MeldDeclared");
        RegisterGameWonHandler("GameWon");
        RegisterRefreshHandler("GameStateUpdated", "State updated");

        // Compatibility aliases for server/client naming drift.
        RegisterPlayerJoinedHandler("PlayerJoin");
        RegisterTileDrawnHandler("DrawnTile");
        RegisterTileDiscardedHandler("DiscardedTile");
        RegisterMeldDeclaredHandler("Meld");
        RegisterGameWonHandler("WinDeclared");

        _hub.Reconnecting += error =>
        {
            LiveStatus = $"Reconnecting to live updates{(error is null ? string.Empty : $": {error.Message}")}";
            return InvokeAsync(StateHasChanged);
        };

        _hub.Reconnected += async _ =>
        {
            LiveStatus = "Live updates reconnected.";
            await RefreshLiveStateAsync();
        };

        _hub.Closed += error =>
        {
            if (_disposeCts.IsCancellationRequested)
            {
                return Task.CompletedTask;
            }

            LiveStatus = $"Live updates disconnected{(error is null ? "." : $": {error.Message}")}";
            return InvokeAsync(StateHasChanged);
        };

        await _hub.StartAsync(_disposeCts.Token);
        await _hub.SendAsync("JoinGame", gameId.ToString(), _disposeCts.Token);

        LiveStatus = $"Connected to live updates for game {gameId}.";
    }

    private void RegisterRefreshHandler(string hubEventName, string displayName)
    {
        _hub?.On<object>(hubEventName, _ => _ = RefreshFromEventAsync(displayName));
    }

    private void RegisterPlayerJoinedHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.JoinGameResponse>(hubEventName, payload => _ = HandlePlayerJoinedEventAsync(payload));
    }

    private void RegisterGameStartedHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.StartGameResponse>(hubEventName, payload => _ = HandleGameStartedEventAsync(payload));
    }

    private void RegisterTileDrawnHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.DrawTileResponse>(hubEventName, payload => _ = HandleTileDrawnEventAsync(payload));
    }

    private void RegisterTileDiscardedHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.DiscardTileResponse>(hubEventName, payload => _ = HandleTileDiscardedEventAsync(payload));
    }

    private void RegisterMeldDeclaredHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.MeldResponse>(hubEventName, payload => _ = HandleMeldDeclaredEventAsync(payload));
    }

    private void RegisterGameWonHandler(string hubEventName)
    {
        _hub?.On<GameApiClient.WinResponse>(hubEventName, payload => _ = HandleGameWonEventAsync(payload));
    }

    private Task HandlePlayerJoinedEventAsync(GameApiClient.JoinGameResponse payload)
    {
        RecordLiveEvent($"Player joined: {payload.Name} ({payload.Seat})");
        return RefreshFromEventAsync($"Player joined: {payload.Name} ({payload.Seat})");
    }

    private Task HandleGameStartedEventAsync(GameApiClient.StartGameResponse payload)
    {
        var dealer = payload.DealerId?.ToString()[..8] ?? "unknown";
        RecordLiveEvent($"Game started (dealer {dealer})");
        return RefreshFromEventAsync($"Game started (dealer {dealer})");
    }

    private Task HandleTileDrawnEventAsync(GameApiClient.DrawTileResponse payload)
    {
        _lastDrawnTileId = payload.TileId;
        RecordLiveEvent($"Tile drawn: {payload.Suit} {payload.Rank}");
        return RefreshFromEventAsync("Tile drawn");
    }

    private Task HandleTileDiscardedEventAsync(GameApiClient.DiscardTileResponse _)
    {
        _lastDrawnTileId = null;
        RecordLiveEvent("Tile discarded");
        return RefreshFromEventAsync("Tile discarded");
    }

    private Task HandleMeldDeclaredEventAsync(GameApiClient.MeldResponse payload)
    {
        _lastDrawnTileId = null;
        RecordLiveEvent($"Meld declared: {payload.Type} ({payload.TileIds.Count} tiles)");
        return RefreshFromEventAsync($"Meld declared: {payload.Type} ({payload.TileIds.Count} tiles)");
    }

    private Task HandleGameWonEventAsync(GameApiClient.WinResponse payload)
    {
        _latestWin = payload;
        var winner = ResolvePlayerName(payload.PlayerId, payload.PlayerId.ToString()[..8]);
        var winTypeSummary = payload.ChangshaWinTypes is { Count: > 0 }
            ? $" ({string.Join(", ", payload.ChangshaWinTypes)})"
            : string.Empty;
        var settlementSummary = payload.ScoreDeltas is { Count: > 0 }
            ? $", settlement {payload.ScoreDeltas.Count} entries"
            : string.Empty;
        var birdSummary = string.IsNullOrWhiteSpace(payload.BirdSeat)
            ? string.Empty
            : $", bird {payload.BirdSeat}";
        var nextRoundSummary = payload.NextRound is int round
            ? $", next round {round}"
            : string.Empty;

        RecordLiveEvent($"Game won by {winner}{winTypeSummary}");
        return RefreshFromEventAsync($"Game won by {winner}{winTypeSummary}{settlementSummary}{birdSummary}{nextRoundSummary}");
    }

    private Task RefreshFromEventAsync(string eventName)
    {
        LiveStatus = $"Event received: {eventName}. Refreshing live state...";
        return RefreshLiveStateAsync();
    }

    private async Task RefreshLiveStateAsync(bool triggerBotTurn = true)
    {
        if (GameId is null || _disposeCts.IsCancellationRequested)
        {
            return;
        }

        try
        {
            _liveState = await Api.GetGameStateAsync(GameId.Value, PlayerId, _disposeCts.Token);
            if (_selectedMeldTileIds.Count > 0)
            {
                var viewerHandIds = _liveState.ViewerHand.Select(tile => tile.Id).ToHashSet();
                _selectedMeldTileIds.RemoveWhere(tileId => !viewerHandIds.Contains(tileId));
            }
            if (!_winIsSelfDraw && _winDiscarderPlayerId is null)
            {
                _winDiscarderPlayerId = _liveState.LastDiscardPlayerId;
            }
            LiveStatus = $"Live state refreshed at {DateTime.Now:T}. Status: {_liveState.Status}";
            await InvokeAsync(StateHasChanged);

            if (triggerBotTurn)
            {
                await MaybeTriggerBotTurnAsync();
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            // ignore shutdown cancellation
        }
        catch (Exception ex)
        {
            LiveStatus = $"Live refresh failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MaybeTriggerBotTurnAsync()
    {
        if (_botTurnInFlight || GameId is null || _liveState is null || _disposeCts.IsCancellationRequested)
        {
            return;
        }

        if (!IsLiveGameActive(_liveState.Status))
        {
            return;
        }

        var currentPlayer = _liveState.Players.FirstOrDefault(player => player.Id == _liveState.CurrentPlayerId);
        if (currentPlayer is null || !IsBotName(currentPlayer.Name))
        {
            return;
        }

        _botTurnInFlight = true;

        try
        {
            var result = await Api.TriggerBotTurnAsync(GameId.Value, _disposeCts.Token);
            LiveStatus = result.Won
                ? $"{currentPlayer.Name} won the hand."
                : $"{currentPlayer.Name} played a turn.";

            await RefreshLiveStateAsync(triggerBotTurn: false);
        }
        catch (Exception ex)
        {
            LiveStatus = $"Bot turn failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _botTurnInFlight = false;
        }
    }

    private async Task DrawTileAsync()
    {
        if (!CanDraw || GameId is null || PlayerId is null)
        {
            return;
        }

        try
        {
            var result = await Api.DrawTileAsync(GameId.Value, new GameApiClient.DrawTileRequest(PlayerId.Value), _disposeCts.Token);
            _lastDrawnTileId = result.TileId;
            LiveStatus = $"Drew tile {result.Suit} {result.Rank}.";
            RecordLiveEvent($"Drew tile {result.Suit} {result.Rank}");
            await RefreshLiveStateAsync();
        }
        catch (Exception ex)
        {
            LiveStatus = $"Draw failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DiscardLastDrawnTileAsync()
    {
        if (!CanDiscard || GameId is null || PlayerId is null || _lastDrawnTileId is null)
        {
            return;
        }

        try
        {
            var result = await Api.DiscardTileAsync(
                GameId.Value,
                new GameApiClient.DiscardTileRequest(PlayerId.Value, _lastDrawnTileId.Value),
                _disposeCts.Token);

            _lastDrawnTileId = null;
            LiveStatus = $"Discarded tile sequence #{result.Sequence}.";
            RecordLiveEvent($"Discarded tile sequence #{result.Sequence}");
            await RefreshLiveStateAsync();
        }
        catch (Exception ex)
        {
            LiveStatus = $"Discard failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeclareMeldAsync()
    {
        if (!CanMeld || GameId is null || PlayerId is null)
        {
            return;
        }

        if (_selectedMeldTileIds.Count != RequiredMeldTileCount)
        {
            LiveStatus = $"Select exactly {RequiredMeldTileCount} tile(s) for {_selectedMeldType}.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var result = await Api.DeclareMeldAsync(
                GameId.Value,
                new GameApiClient.MeldRequest(PlayerId.Value, _selectedMeldType, _selectedMeldTileIds.ToList()),
                _disposeCts.Token);

            _selectedMeldTileIds.Clear();
            _lastDrawnTileId = null;
            LiveStatus = $"Declared {_selectedMeldType} ({result.TileIds.Count} tiles).";
            RecordLiveEvent($"Declared {_selectedMeldType} ({result.TileIds.Count} tiles)");
            await RefreshLiveStateAsync();
        }
        catch (Exception ex)
        {
            LiveStatus = $"Declare meld failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeclareWinAsync()
    {
        if (!CanDeclareWin || GameId is null || PlayerId is null)
        {
            return;
        }

        try
        {
            if (!TryParseBirdRank(out var birdRank))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (!_winIsSelfDraw && _winDiscarderPlayerId is null)
            {
                LiveStatus = "Select a discarder when declaring a discard win.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var result = await Api.DeclareWinAsync(
                GameId.Value,
                new GameApiClient.WinRequest(
                    PlayerId.Value,
                    IsSelfDraw: _winIsSelfDraw,
                    DiscarderPlayerId: _winIsSelfDraw ? null : _winDiscarderPlayerId,
                    BirdRank: birdRank,
                    IsMultipleWin: !_winIsSelfDraw && _winIsMultipleWin),
                _disposeCts.Token);

            _latestWin = result;
            var winTypeSummary = result.ChangshaWinTypes is { Count: > 0 }
                ? $" ({string.Join(", ", result.ChangshaWinTypes)})"
                : string.Empty;
            var scoreDeltaSummary = result.ScoreDeltas is { Count: > 0 }
                ? $", settlement entries: {result.ScoreDeltas.Count}"
                : string.Empty;

            LiveStatus = $"Win declared{winTypeSummary}{scoreDeltaSummary}.";
            RecordLiveEvent($"Win declared{winTypeSummary}");
            await RefreshLiveStateAsync();
        }
        catch (Exception ex)
        {
            LiveStatus = $"Declare win failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TryParseBirdRank(out int? birdRank)
    {
        birdRank = null;
        if (string.IsNullOrWhiteSpace(_winBirdRankText))
        {
            return true;
        }

        if (int.TryParse(_winBirdRankText, out var parsedRank) && parsedRank is >= 1 and <= 9)
        {
            birdRank = parsedRank;
            return true;
        }

        LiveStatus = "Bird rank must be between 1 and 9.";
        return false;
    }

    private bool IsMeldTileSelected(Guid tileId)
        => _selectedMeldTileIds.Contains(tileId);

    private void ToggleMeldTileSelection(Guid? tileId)
    {
        if (tileId is not { } selectedTileId || !CanMeld)
        {
            return;
        }

        if (!_selectedMeldTileIds.Add(selectedTileId))
        {
            _selectedMeldTileIds.Remove(selectedTileId);
            return;
        }

        if (_selectedMeldTileIds.Count <= RequiredMeldTileCount)
        {
            return;
        }

        _selectedMeldTileIds.Remove(selectedTileId);
        LiveStatus = $"Only {RequiredMeldTileCount} tile(s) can be selected for {_selectedMeldType}.";
    }

    private void SetMeldType(string meldType)
    {
        if (string.IsNullOrWhiteSpace(meldType))
        {
            return;
        }

        if (!string.Equals(_selectedMeldType, meldType, StringComparison.OrdinalIgnoreCase))
        {
            _selectedMeldType = meldType;
            _selectedMeldTileIds.Clear();
        }

        LiveStatus = $"Claim option selected: {_selectedMeldType}.";
    }

    private void SetDiscardWinClaim()
    {
        _winIsSelfDraw = false;
        _winDiscarderPlayerId = _liveState?.LastDiscardPlayerId ?? _winDiscarderPlayerId;
        LiveStatus = "Claim option selected: Win on discard.";
    }

    private void PassClaimSelection()
    {
        _selectedMeldTileIds.Clear();
        _winIsSelfDraw = true;
        _winDiscarderPlayerId = null;
        _winIsMultipleWin = false;
        LiveStatus = "Claim options cleared (pass).";
    }

    private void OnWinSelfDrawChanged(ChangeEventArgs args)
    {
        _winIsSelfDraw = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        if (_winIsSelfDraw)
        {
            _winDiscarderPlayerId = null;
            _winIsMultipleWin = false;
            return;
        }

        _winDiscarderPlayerId ??= _liveState?.LastDiscardPlayerId;
    }

    private void HandleDiscarderSelectionChanged(ChangeEventArgs args)
    {
        _winDiscarderPlayerId = Guid.TryParse(args.Value?.ToString(), out var playerId)
            ? playerId
            : null;
    }

    private void HandleBirdRankChanged(ChangeEventArgs args)
    {
        _winBirdRankText = args.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private void RecordLiveEvent(string description)
    {
        _liveEvents.Insert(0, ($"{DateTime.Now:t}", description));
        if (_liveEvents.Count > 12)
        {
            _liveEvents.RemoveAt(_liveEvents.Count - 1);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();

        if (_hub is null)
        {
            _disposeCts.Dispose();
            return;
        }

        try
        {
            if (GameId is not null)
            {
                await _hub.SendAsync("LeaveGame", GameId.Value.ToString());
            }

            await _hub.DisposeAsync();
        }
        catch
        {
            // ignore shutdown errors in UI teardown
        }
        finally
        {
            _disposeCts.Dispose();
        }
    }

    private string ResolvePlayerName(Guid? playerId, string fallback)
    {
        if (playerId is null || _liveState?.Players is null)
        {
            return fallback;
        }

        return _liveState.Players.FirstOrDefault(player => player.Id == playerId.Value)?.Name ?? fallback;
    }

    private string ResolveSeat(Guid? playerId, string fallback)
    {
        if (playerId is null || _liveState?.Players is null)
        {
            return fallback;
        }

        return _liveState.Players.FirstOrDefault(player => player.Id == playerId.Value)?.Seat ?? fallback;
    }

    private string BuildSeatAnchorClass(string seat)
    {
        var classes = $"seat-anchor anchor-{seat.ToLowerInvariant()}";

        if (string.Equals(CurrentTurnSeat, seat, StringComparison.OrdinalIgnoreCase))
        {
            classes += " seat-anchor-current";
        }

        if (IsDealerSide(seat))
        {
            classes += " seat-anchor-dealer";
        }

        return classes;
    }

    private static string BuildSeatSummaryItemClass(string wind)
    {
        if (string.IsNullOrWhiteSpace(wind))
        {
            return "seat-summary-item";
        }

        var normalized = wind.Trim().ToLowerInvariant();
        return normalized is "north" or "east" or "south" or "west"
            ? $"seat-summary-item seat-summary-{normalized}"
            : "seat-summary-item";
    }

    private bool IsDealerSide(string seat)
        => string.Equals(CurrentDealerSeat, seat, StringComparison.OrdinalIgnoreCase);

    private string BuildCompassMarkerClass(string wind)
    {
        var classes = $"compass-marker compass-{wind.ToLowerInvariant()}";

        if (string.Equals(RoundWind, wind, StringComparison.OrdinalIgnoreCase))
        {
            classes += " compass-marker-active";
        }

        return classes;
    }

    private PlayerView GetPlayerView(string seat, PlayerView fallback)
    {
        if (_liveState?.Players is null)
        {
            return fallback;
        }

        var player = _liveState.Players.FirstOrDefault(p => string.Equals(p.Seat, seat, StringComparison.OrdinalIgnoreCase));
        if (player is null)
        {
            return fallback with { Name = "Open", Score = 0, IsDealer = false, IsCurrent = false, Discards = new List<string>(), Hand = new List<string>(), HandCount = 0 };
        }

        var discards = _liveState.Discards
            .Where(discard => discard.PlayerId == player.Id)
            .OrderBy(discard => discard.Sequence)
            .Select(discard => discard.TileLabel)
            .ToList();
        var isViewer = PlayerId == player.Id;
        var viewerHand = isViewer
            ? _liveState.ViewerHand.Select(tile => tile.Label).ToList()
            : new List<string>();

        return fallback with
        {
            Name = player.Name,
            Seat = player.Seat,
            Score = player.Score,
            Discards = discards,
            Hand = viewerHand,
            HandCount = isViewer && viewerHand.Count > 0 ? viewerHand.Count : player.HandCount,
            IsDealer = _liveState.DealerId == player.Id,
            IsCurrent = _liveState.CurrentPlayerId == player.Id
        };
    }

    private PlayerView GetViewerHandPlayerView()
    {
        if (_liveState?.Players is null || PlayerId is null)
        {
            return PlayerSouth;
        }

        var player = _liveState.Players.FirstOrDefault(candidate => candidate.Id == PlayerId.Value);
        if (player is null)
        {
            return PlayerSouth;
        }

        var fallback = GetFallbackPlayerView(player.Seat);
        return GetPlayerView(player.Seat, fallback);
    }

    private static PlayerView GetFallbackPlayerView(string seat)
        => seat switch
        {
            "North" => MockState.PlayerNorth,
            "West" => MockState.PlayerWest,
            "East" => MockState.PlayerEast,
            "South" => MockState.PlayerSouth,
            _ => MockState.PlayerSouth
        };

