            "North" => 8,
            _ => 12
        };
    }

    private RenderFragment RenderSeat(PlayerView player) => @<div class="seat-card">
        <div class="d-flex align-items-center justify-content-between seat-card-header">
            <div class="seat-identity">
                <span class="seat-avatar" aria-hidden="true">@GetSeatMonogram(player.Seat)</span>
                <div>
                    <div class="fw-semibold">@player.Name</div>
                    <div class="small text-muted">@player.Seat</div>
                </div>
            </div>
            <div class="text-end seat-badges">
                <div class="badge text-bg-light seat-badge seat-badge-score">@player.Score pts</div>
                @if (player.IsDealer)
                {
                    <div class="badge text-bg-warning ms-1 seat-badge seat-badge-dealer">Dealer</div>
                }
                @if (player.IsCurrent)
                {
                    <div class="badge text-bg-success ms-1 seat-badge seat-badge-turn">Turn</div>
                }
            </div>
        </div>
        <div class="tile-row tile-row-wrap mt-2 seat-tiles seat-@player.Seat.ToLowerInvariant()">
            @foreach (var tile in player.Discards)
            {
                <Tile Label="@tile" />
            }
        </div>
        @{ var hiddenPreviewLimit = GetHiddenHandPreviewLimit(player.Seat); }
        <div class="tile-row tile-row-wrap mt-2 seat-tiles seat-@player.Seat.ToLowerInvariant()">
            @foreach (var tile in BuildHiddenHandPreview(player.HandCount, hiddenPreviewLimit))
            {
                <Tile Label="@tile" IsFaceDown="true" />
            }
            @if (player.HandCount > hiddenPreviewLimit)
            {
                <span class="seat-hand-overflow">+@(player.HandCount - hiddenPreviewLimit)</span>
            }
        </div>
    </div>;

    private static string GetSeatMonogram(string seat) =>
        string.IsNullOrWhiteSpace(seat) ? "?" : seat[..1].ToUpperInvariant();

    private sealed record HandTileView(Guid? Id, string Label);
    private record PlayerView(string Seat, string Name, int Score, List<string> Discards, List<string> Hand, int HandCount, bool IsDealer, bool IsCurrent);

    private record WallStackView(int Index, bool IsBreakMarker, bool IsAfterBreak, bool IsDepleted);

