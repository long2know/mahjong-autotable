@page "/game"

<PageTitle>Game</PageTitle>

<h1>Game</h1>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Table</h5>
                <p class="text-muted mb-0">Board state rendering and live updates will appear here.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Your Hand</h5>
                <p class="text-muted mb-0">Player tiles + action buttons go here.</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Actions</h5>
                <button class="btn btn-outline-primary me-2" disabled>Draw</button>
                <button class="btn btn-outline-secondary" disabled>Discard</button>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-3">Wire this to SignalR updates and API actions when the client services are ready.</p>
