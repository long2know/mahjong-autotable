@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted small">Host a new table and invite friends.</p>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ruleset</label>
                    <select class="form-select">
                        <option selected>Traditional Chinese (MVP)</option>
                        <option disabled>Hong Kong (coming later)</option>
                        <option disabled>Riichi (later)</option>
                    </select>
                </div>
                <button class="btn btn-primary w-100" disabled>Create table</button>
                <p class="text-muted small mt-3 mb-0">Create will call <code>/api/game</code> once wired.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <p class="text-muted small">Enter a game code from the host.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="e.g. 8F3Q" />
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-secondary" disabled>Join</button>
                    <button class="btn btn-outline-secondary" disabled>Reconnect</button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">Active Tables</h5>
                    <span class="badge text-bg-light">Mock data</span>
                </div>
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Game ID</th>
                                <th>Host</th>
                                <th>Players</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge text-bg-dark">8F3Q</span></td>
                                <td>Jun</td>
                                <td>3 / 4</td>
                                <td><span class="badge text-bg-warning">Waiting</span></td>
                                <td><button class="btn btn-outline-primary btn-sm" disabled>Join</button></td>
                            </tr>
                            <tr>
                                <td><span class="badge text-bg-dark">9A1K</span></td>
                                <td>Mina</td>
                                <td>4 / 4</td>
                                <td><span class="badge text-bg-success">In game</span></td>
                                <td><button class="btn btn-outline-secondary btn-sm" disabled>View</button></td>
                            </tr>
                            <tr>
                                <td><span class="badge text-bg-dark">2C7P</span></td>
                                <td>Kai</td>
                                <td>1 / 4</td>
                                <td><span class="badge text-bg-info">Open</span></td>
                                <td><button class="btn btn-outline-primary btn-sm" disabled>Join</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small mb-0">This list will populate from the lobby endpoint later.</p>
            </div>
        </div>
    </div>
</div>
