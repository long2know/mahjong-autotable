@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-3 lobby-metrics">
    <div class="col-12 col-md-4">
        <div class="card lobby-stat">
            <div class="card-body">
                <div class="text-muted small">Open Tables</div>
                <div class="display-6 fw-semibold">3</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card lobby-stat">
            <div class="card-body">
                <div class="text-muted small">Players Online</div>
                <div class="display-6 fw-semibold">11</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card lobby-stat">
            <div class="card-body">
                <div class="text-muted small">Ready Games</div>
                <div class="display-6 fw-semibold">1</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted">Start a fresh table and invite friends.</p>
                <div class="alert alert-primary small mb-3" role="alert">
                    You are seated as <strong>South</strong> by default in the MVP.
                </div>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Weekend tiles" />
                </div>
                <button class="btn btn-primary w-100" disabled>Create</button>
                <p class="text-muted small mt-3 mb-0">Wire to POST /api/game when ready.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <p class="text-muted">Enter a game ID to jump in.</p>
                <div class="alert alert-secondary small mb-3" role="alert">
                    Waiting rooms lock once 4 seats are filled.
                </div>
                <div class="mb-3">
                    <label class="form-label">Game ID</label>
                    <input class="form-control" placeholder="MC-2048" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <button class="btn btn-secondary w-100" disabled>Join</button>
                <p class="text-muted small mt-3 mb-0">Wire to POST /api/game/{id}/join.</p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="card-title mb-1">Open Tables</h5>
                <p class="text-muted mb-0">Mock data until SignalR lobby feed arrives.</p>
            </div>
            <button class="btn btn-outline-primary btn-sm" disabled>Refresh</button>
        </div>
        <div class="table-responsive mt-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Table</th>
                        <th>Host</th>
                        <th>Players</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in OpenTables)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="text-muted small">@table.GameId</div>
                            </td>
                            <td>@table.Host</td>
                            <td>@table.Players</td>
                            <td>
                                <span class="badge text-bg-@table.StatusStyle">@table.Status</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" disabled>View</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<LobbyTable> OpenTables => new[]
    {
        new LobbyTable("Weekend Run", "MC-2048", "Jun", "2 / 4", "Waiting", "success"),
        new LobbyTable("Family Night", "MC-1091", "Kai", "4 / 4", "Full", "secondary"),
        new LobbyTable("Practice", "MC-3377", "Mina", "1 / 4", "Waiting", "success")
    };

    private record LobbyTable(string Name, string GameId, string Host, string Players, string Status, string StatusStyle);
}
