@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<p class="text-muted">Create a room or join an existing table. SignalR wiring comes next.</p>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Saturday Night Mahjong" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" disabled>Create</button>
                    <button class="btn btn-outline-secondary" disabled>Invite friends</button>
                </div>
                <p class="text-muted small mt-3 mb-0">API wiring for create + invite is pending.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <div class="mb-3">
                    <label class="form-label">Game ID</label>
                    <input class="form-control" placeholder="Game id" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <button class="btn btn-secondary" disabled>Join</button>
                <p class="text-muted small mt-3 mb-0">Join uses the server lobby endpoint once ready.</p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5 class="card-title mb-0">Open Tables</h5>
            <button class="btn btn-outline-primary btn-sm" disabled>Refresh</button>
        </div>
        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle lobby-table">
                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Host</th>
                        <th>Seats</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Harbor Lights</td>
                        <td>Ari</td>
                        <td>2 / 4</td>
                        <td><span class="badge text-bg-success">Waiting</span></td>
                        <td class="text-end"><button class="btn btn-outline-secondary btn-sm" disabled>Join</button></td>
                    </tr>
                    <tr>
                        <td>Morning Wind</td>
                        <td>Jun</td>
                        <td>4 / 4</td>
                        <td><span class="badge text-bg-secondary">Full</span></td>
                        <td class="text-end"><button class="btn btn-outline-secondary btn-sm" disabled>Join</button></td>
                    </tr>
                    <tr>
                        <td>Golden Bamboo</td>
                        <td>Mei</td>
                        <td>1 / 4</td>
                        <td><span class="badge text-bg-warning">Starting</span></td>
                        <td class="text-end"><button class="btn btn-outline-secondary btn-sm" disabled>Join</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0">Live table list will load once the lobby service is connected.</p>
    </div>
</div>
