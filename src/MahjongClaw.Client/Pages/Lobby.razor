@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted">Spin up a new table and invite friends.</p>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Friday Night Mahjong" />
                </div>
                <button class="btn btn-primary w-100" disabled>Create table</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <p class="text-muted">Enter a game id or select an open table below.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="e.g. 7P4K8" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <button class="btn btn-secondary mt-3" disabled>Join with code</button>

                <div class="mt-4">
                    <h6 class="text-uppercase text-muted">Open Tables</h6>
                    <div class="lobby-table-list">
                        @foreach (var table in OpenTables)
                        {
                            <div class="lobby-table">
                                <div>
                                    <div class="fw-semibold">@table.Name</div>
                                    <div class="small text-muted">ID: @table.Id · @table.Status</div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge text-bg-light">@table.SeatsFilled/4</span>
                                    <button class="btn btn-sm btn-outline-primary" disabled>Join</button>
                                </div>
                                <div class="lobby-seats mt-3">
                                    @foreach (var seat in table.Seats)
                                    {
                                        <div class="lobby-seat">
                                            <span class="badge rounded-pill text-bg-secondary">@seat.Seat</span>
                                            <span class="small">@seat.Player</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-3">Wire these panels to the API (create/join) once client services are in place.</p>

@code {
    private IReadOnlyList<LobbyTableView> OpenTables => new[]
    {
        new LobbyTableView("Friday Night Mahjong", "7P4K8", "Waiting for players", 2, new()
        {
            new LobbySeatView("East", "Jun"),
            new LobbySeatView("South", "Open"),
            new LobbySeatView("West", "Mina"),
            new LobbySeatView("North", "Open")
        }),
        new LobbyTableView("Office League", "Q2Z91", "Ready", 4, new()
        {
            new LobbySeatView("East", "Luca"),
            new LobbySeatView("South", "Tori"),
            new LobbySeatView("West", "Arun"),
            new LobbySeatView("North", "You")
        })
    };

    private record LobbyTableView(string Name, string Id, string Status, int SeatsFilled, List<LobbySeatView> Seats);
    private record LobbySeatView(string Seat, string Player);
}
