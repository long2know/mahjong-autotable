@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted small">Start a new table and invite friends with the game ID.</p>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Room label</label>
                    <input class="form-control" placeholder="Saturday night table" />
                </div>
                <button class="btn btn-primary w-100" disabled>Create game</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="eg. 8f4b21" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <button class="btn btn-outline-secondary mt-3 w-100" disabled>Join</button>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">Open Tables</h5>
                    <span class="badge text-bg-light">Mock</span>
                </div>
                <div class="list-group list-group-flush mt-3">
                    @foreach (var table in OpenTables)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="text-muted small">@table.Players/@table.Capacity players · @table.Region</div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" disabled>Join</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-3">Wire these buttons to the API (create/join) once the client services are in place.</p>

@code {
    private IReadOnlyList<TableView> OpenTables => new[]
    {
        new TableView("East Wind Lounge", 3, 4, "US-West"),
        new TableView("Red Dragon Room", 2, 4, "US-East"),
        new TableView("Bamboo Garden", 4, 4, "EU-Central")
    };

    private record TableView(string Name, int Players, int Capacity, string Region);
}
