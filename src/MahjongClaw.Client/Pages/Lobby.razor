@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>
<p class="text-muted">Create a new table or join an existing game. This is mocked UI until API wiring lands.</p>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Saturday Night Mahjong" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Starting score</label>
                    <select class="form-select">
                        <option>25000</option>
                        <option>20000</option>
                        <option>15000</option>
                    </select>
                </div>
                <button class="btn btn-primary w-100" disabled>Create</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="card-title mb-0">Join Game</h5>
                    <span class="badge text-bg-light">3 tables live</span>
                </div>
                <div class="mt-3 lobby-list">
                    @foreach (var table in Tables)
                    {
                        <div class="lobby-entry">
                            <div>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="small text-muted">Host: @table.Host · @table.Players/4 players</div>
                            </div>
                            <div class="text-end">
                                <div class="badge text-bg-secondary">@table.Code</div>
                                <button class="btn btn-sm btn-outline-secondary ms-2" disabled>Join</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="row g-3 mt-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="MC-4829" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <button class="btn btn-secondary w-100 mt-3" disabled>Join with ID</button>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-3">Buttons are disabled until API endpoints for lobby creation and joining are wired.</p>

@code {
    private IReadOnlyList<TablePreview> Tables => new[]
    {
        new TablePreview("Dragon Gate", "Jun", 2, "MC-4829"),
        new TablePreview("Evening Winds", "Mina", 3, "MC-3174"),
        new TablePreview("Lucky Bamboo", "Kai", 1, "MC-9961")
    };

    private record TablePreview(string Name, string Host, int Players, string Code);
}
