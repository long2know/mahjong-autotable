@page "/lobby"
@using MahjongClaw.Client.Services
@inject GameApiClient Api
@inject NavigationManager Navigation

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted small">Create a table, then share the game ID for players to join.</p>

                <div class="mb-3">
                    <label class="form-label">Host name</label>
                    <input class="form-control" @bind="HostName" placeholder="Enter your name" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-7">
                        <label class="form-label">Game mode</label>
                        <select class="form-select" @bind="CreateMode">
                            <option value="HumanVsHuman">Human vs Human</option>
                            <option value="HumanVsBot">Human vs Bot</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label">Bot seats</label>
                        <select class="form-select" @bind="BotSeatCount" disabled="@(CreateMode != "HumanVsBot")">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ruleset</label>
                    <select class="form-select" @bind="CreateRuleset">
                        <option value="ChineseOfficial">Chinese Official</option>
                        <option value="Changsha258">Changsha 258 (2/5/8 pair)</option>
                    </select>
                </div>

                <button class="btn btn-primary" @onclick="CreateGameAsync" disabled="@IsBusy">Create</button>

                @if (CreatedGameId is not null)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <div><strong>Game created:</strong> @CreatedGameId</div>
                        <div class="small">Mode: @FormatCreateMode() @FormatBotSeatSummary()</div>
                        <div class="small">Ruleset: @FormatRuleset()</div>
                        <div class="small">Share this ID with other players.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Join / Start Game</h5>
                <p class="text-muted small">Join by game ID, then start once 4 seats are filled.</p>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" @bind="JoinGameId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" @bind="JoinName" placeholder="Enter your name" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Seat</label>
                        <select class="form-select" @bind="JoinSeat">
                            @foreach (var seat in Seats)
                            {
                                <option value="@seat">@seat</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-secondary" @onclick="JoinGameAsync" disabled="@IsBusy">Join</button>
                    <button class="btn btn-outline-primary" @onclick="StartGameAsync" disabled="@IsBusy">Start</button>
                    <button class="btn btn-outline-dark" @onclick="OpenGameAsync" disabled="@IsBusy">Open Game</button>
                </div>

                <div class="row g-3 mt-3 lobby-metrics">
                    <div class="col-12 col-md-4">
                        <div class="card h-100">
                            <div class="card-body lobby-stat">
                                <div class="small text-muted text-uppercase">Players Online</div>
                                <div class="display-6 fw-semibold">128</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100">
                            <div class="card-body lobby-stat">
                                <div class="small text-muted text-uppercase">Tables Active</div>
                                <div class="display-6 fw-semibold">24</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100">
                            <div class="card-body lobby-stat">
                                <div class="small text-muted text-uppercase">Avg Wait</div>
                                <div class="display-6 fw-semibold">2m</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="divider" aria-hidden="true"></div>

                <div class="lobby-list">
                    @foreach (var table in OpenTables)
                    {
                        <div class="lobby-item">
                            <div>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="small text-muted d-flex align-items-center gap-2 flex-wrap">
                                    <span>@table.Host • @table.Region</span>
                                    <span class="badge @GetStatusBadge(table.Status)">@table.Status</span>
                                    <span class="text-muted">Code: @table.Code</span>
                                    <span class="seat-indicator" aria-label="Seats filled">
                                        @for (var seat = 0; seat < 4; seat++)
                                        {
                                            <span class="seat-dot @(seat < table.Players ? "seat-dot-filled" : "")"></span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="badge text-bg-primary">@table.Players / 4 seats</div>
                                <button class="btn btn-sm btn-outline-primary ms-2" disabled="@(!table.CanJoin)">Join</button>
                            </div>
                        </div>
                    }
                </div>

                @if (LastJoinedPlayerId is not null)
                {
                    <p class="text-muted small mt-3 mb-0">Joined player ID: @LastJoinedPlayerId</p>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger mt-3">@Error</div>
}

@if (!string.IsNullOrWhiteSpace(Status))
{
    <div class="alert alert-info mt-3 mb-0">@Status</div>
}

@code {
    private static readonly string[] Seats = ["East", "South", "West", "North"];

    private string HostName { get; set; } = string.Empty;
    private string JoinGameId { get; set; } = string.Empty;
    private string JoinName { get; set; } = string.Empty;
    private string JoinSeat { get; set; } = "South";
    private string CreateMode { get; set; } = "HumanVsHuman";
    private string CreateRuleset { get; set; } = "ChineseOfficial";
    private int BotSeatCount { get; set; } = 1;

    private Guid? CreatedGameId { get; set; }
    private Guid? LastJoinedPlayerId { get; set; }
    private string? Status { get; set; }
    private string? Error { get; set; }
    private bool IsBusy { get; set; }

    private IReadOnlyList<TableView> OpenTables => new[]
    {
        new TableView("Golden Dragons", "Jun", "US West", 3, "Waiting", "X8K2", true),
        new TableView("Family Table", "Mina", "US Central", 2, "In Progress", "LQ7P", false)
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "Waiting" => "text-bg-success",
        "In Progress" => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private async Task CreateGameAsync()
    {
        await RunWithStatusAsync(async () =>
        {
            if (CreateMode == "HumanVsBot" && string.IsNullOrWhiteSpace(HostName))
            {
                throw new InvalidOperationException("Host name is required for Human vs Bot setup.");
            }

            var request = new GameApiClient.CreateGameRequest(
                string.IsNullOrWhiteSpace(HostName) ? null : HostName.Trim(),
                CreateMode,
                BotSeatCount,
                CreateRuleset);

            var created = await Api.CreateGameAsync(request);
            CreatedGameId = created.Id;
            JoinGameId = created.Id.ToString();
            LastJoinedPlayerId = created.HostPlayerId;

            if (!string.IsNullOrWhiteSpace(HostName))
            {
                JoinName = HostName.Trim();
            }

            if (CreateMode == "HumanVsBot" && created.HostPlayerId is null)
            {
                await ConfigureHumanVsBotSeatsAsync(created.Id);
            }

            Status = $"Game created: {created.Id} ({FormatCreateMode()}{FormatBotSeatSummary()}, {FormatRuleset()}).";
        });
    }

    private async Task JoinGameAsync()
    {
        await RunWithStatusAsync(async () =>
        {
            var gameId = ParseGameIdOrThrow();
            var name = string.IsNullOrWhiteSpace(JoinName) ? HostName : JoinName;

            if (string.IsNullOrWhiteSpace(name))
            {
                throw new InvalidOperationException("Enter a player name before joining.");
            }

            var joined = await Api.JoinGameAsync(gameId, new GameApiClient.JoinGameRequest(name.Trim(), JoinSeat));
            LastJoinedPlayerId = joined.PlayerId;
            Status = $"Joined {joined.GameId} as {joined.Seat}.";
        });
    }

    private async Task StartGameAsync()
    {
        await RunWithStatusAsync(async () =>
        {
            var gameId = ParseGameIdOrThrow();
            var started = await Api.StartGameAsync(gameId);
            Status = $"Game started. Current player: {started.CurrentPlayerId}";
        });
    }

    private Task OpenGameAsync()
    {
        try
        {
            var gameId = ParseGameIdOrThrow();
            var playerPart = LastJoinedPlayerId is null ? string.Empty : $"&playerId={LastJoinedPlayerId}";
            Navigation.NavigateTo($"/game?gameId={gameId}{playerPart}");
            return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            return Task.CompletedTask;
        }
    }

    private string FormatCreateMode()
        => CreateMode == "HumanVsBot" ? "Human vs Bot" : "Human vs Human";

    private string FormatBotSeatSummary()
        => CreateMode == "HumanVsBot" ? $" ({BotSeatCount} bot seat{(BotSeatCount == 1 ? string.Empty : "s")})" : string.Empty;

    private string FormatRuleset()
        => RulesetHelpers.FormatLabel(CreateRuleset);

    private async Task ConfigureHumanVsBotSeatsAsync(Guid gameId)
    {
        if (string.IsNullOrWhiteSpace(HostName))
        {
            throw new InvalidOperationException("Host name is required for Human vs Bot setup.");
        }

        var seatPlan = new[] { "East", "South", "West", "North" };
        var host = await Api.JoinGameAsync(gameId, new GameApiClient.JoinGameRequest(HostName.Trim(), seatPlan[0]));

        LastJoinedPlayerId = host.PlayerId;
        JoinName = HostName.Trim();
        JoinSeat = host.Seat;

        for (var index = 1; index <= BotSeatCount && index < seatPlan.Length; index++)
        {
            var seat = seatPlan[index];
            var botName = $"Bot {index}";
            await Api.JoinGameAsync(gameId, new GameApiClient.JoinGameRequest(botName, seat));
        }
    }

    private Guid ParseGameIdOrThrow()
    {
        var candidate = string.IsNullOrWhiteSpace(JoinGameId) && CreatedGameId is not null
            ? CreatedGameId.Value.ToString()
            : JoinGameId;

        if (!Guid.TryParse(candidate, out var gameId))
        {
            throw new InvalidOperationException("Enter a valid game ID.");
        }

        return gameId;
    }

    private async Task RunWithStatusAsync(Func<Task> work)
    {
        Error = null;
        IsBusy = true;

        try
        {
            await work();
        }
        catch (Exception ex)
        {
            Status = null;
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private record TableView(string Name, string Host, string Region, int Players, string Status, string Code, bool CanJoin);
}
