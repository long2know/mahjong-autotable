@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted">Start a new table and invite friends to join with the generated game ID.</p>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Preferred seat</label>
                    <select class="form-select">
                        <option selected>Auto-assign</option>
                        <option>East (Dealer)</option>
                        <option>South</option>
                        <option>West</option>
                        <option>North</option>
                    </select>
                </div>
                <button class="btn btn-primary" disabled>Create game</button>
                <div class="alert alert-light border mt-4 mb-0">
                    <div class="small text-muted">Game ID</div>
                    <div class="fw-semibold">MC-2048</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h5 class="card-title mb-1">Join Game</h5>
                        <p class="text-muted mb-0">Enter an existing lobby ID and choose your seat.</p>
                    </div>
                    <span class="badge text-bg-secondary">Open tables: 3</span>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="Game id" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Seat preference</label>
                        <select class="form-select">
                            <option selected>Any seat</option>
                            <option>East</option>
                            <option>South</option>
                            <option>West</option>
                            <option>North</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <button class="btn btn-secondary w-100" disabled>Join game</button>
                    </div>
                </div>

                <div class="mt-4">
                    <h6 class="text-uppercase text-muted">Active Lobbies</h6>
                    <div class="list-group lobby-list">
                        @foreach (var lobby in ActiveLobbies)
                        {
                            <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">@lobby.Name</div>
                                    <div class="small text-muted">Host: @lobby.Host · @lobby.Players/4 players</div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge text-bg-light">@lobby.Status</span>
                                    <button class="btn btn-outline-primary btn-sm" disabled>Join</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-3">Wire create/join actions to the API once client services are in place.</p>

@code {
    private IReadOnlyList<LobbyView> ActiveLobbies => new[]
    {
        new LobbyView("MC-2048", "Warm Bamboo Table", "Jun", 3, "Waiting"),
        new LobbyView("MC-0912", "Dragon's Den", "Mina", 2, "Waiting"),
        new LobbyView("MC-7777", "Evening Wind", "Kai", 4, "Ready")
    };

    private record LobbyView(string Id, string Name, string Host, int Players, string Status);
}
