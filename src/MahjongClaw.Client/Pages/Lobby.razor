@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>
<p class="text-muted">Create a new table or join an existing game. (Mock layout)</p>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table privacy</label>
                    <select class="form-select">
                        <option>Private (invite only)</option>
                        <option>Public (open lobby)</option>
                    </select>
                </div>
                <button class="btn btn-primary w-100" disabled>Create game</button>
                <p class="text-muted small mt-2 mb-0">API wiring comes next.</p>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">Quick tips</h5>
                <ul class="small text-muted mb-0">
                    <li>Games start once 4 seats are filled.</li>
                    <li>Dealer is assigned to East on start.</li>
                    <li>SignalR will deliver live updates.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="Game id" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-secondary" disabled>Join game</button>
                    <button class="btn btn-outline-secondary" disabled>Paste invite link</button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">Open Tables</h5>
                    <span class="badge text-bg-light">3 available</span>
                </div>
                <div class="lobby-table-list mt-3">
                    @foreach (var table in OpenTables)
                    {
                        <div class="lobby-table">
                            <div>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="text-muted small">Game ID: @table.Id</div>
                            </div>
                            <div class="text-end">
                                <div class="small text-muted">Seats</div>
                                <div class="fw-semibold">@table.Seats</div>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-primary" disabled>Join</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<LobbyTable> OpenTables => new[]
    {
        new LobbyTable("Downtown Table", "A1B2", "2 / 4"),
        new LobbyTable("Weekend Winds", "C7D9", "3 / 4"),
        new LobbyTable("Jade Garden", "E5F3", "1 / 4")
    };

    private record LobbyTable(string Name, string Id, string Seats);
}
