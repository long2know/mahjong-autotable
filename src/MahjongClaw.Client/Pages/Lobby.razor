@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>
<p class="text-muted">Create a new table or join an existing game. (Mock layout)</p>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table privacy</label>
                    <select class="form-select">
                        <option>Public (listed)</option>
                        <option>Private (invite only)</option>
                    </select>
                </div>
                <button class="btn btn-primary" disabled>Create</button>
                <p class="text-muted small mt-3 mb-0">Wired to POST /api/game once services are ready.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="card-title mb-0">Join Game</h5>
                    <div class="input-group lobby-search">
                        <span class="input-group-text">Search</span>
                        <input class="form-control" placeholder="Filter by host or table id" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="e.g. 4f1c-28a" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <button class="btn btn-secondary mt-3" disabled>Join Selected</button>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <h6 class="text-uppercase text-muted">Open Tables</h6>
                <div class="list-group list-group-flush lobby-list">
                    @foreach (var table in OpenTables)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-semibold">@table.Id</div>
                                <div class="small text-muted">Host: @table.Host · Seats: @table.SeatsFilled/4</div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" disabled>Join</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<TableView> OpenTables => new[]
    {
        new TableView("ABCD-123", "Jun", 2),
        new TableView("ZXCV-552", "Mina", 1),
        new TableView("QWER-998", "Kai", 3)
    };

    private record TableView(string Id, string Host, int SeatsFilled);
}
