@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <p class="text-muted small">Start a new table and invite your friends.</p>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Saturday night table" />
                </div>
                <button class="btn btn-primary" disabled>Create</button>
                <div class="text-muted small mt-3">Auto-generates a game ID once wired to the API.</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <p class="text-muted small">Paste a game ID or pick from recent tables.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="Game id" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <button class="btn btn-secondary mt-3" disabled>Join</button>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-body">
                <h6 class="text-uppercase text-muted">Recent tables</h6>
                <div class="list-group lobby-list">
                    @foreach (var game in RecentGames)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-semibold">@game.Name</div>
                                <div class="small text-muted">@game.Id • @game.Players/4 players</div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" disabled>Join</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<GameSummary> RecentGames => new[]
    {
        new GameSummary("Moonlight Mahjong", "6F3A9", 3),
        new GameSummary("Wind & Bamboo", "1C8TQ", 2),
        new GameSummary("Lunch Break", "9ZP2M", 4)
    };

    private record GameSummary(string Name, string Id, int Players);
}
