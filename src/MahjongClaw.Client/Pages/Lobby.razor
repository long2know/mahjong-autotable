@page "/lobby"

<PageTitle>Lobby</PageTitle>

<h1>Lobby</h1>

<div class="row g-4">
    <div class="col-12 col-xl-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Create Game</h5>
                <div class="mb-3">
                    <label class="form-label">Player name</label>
                    <input class="form-control" placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Table name</label>
                    <input class="form-control" placeholder="Weekend Mahjong" />
                </div>
                <button class="btn btn-primary">Create</button>
                <p class="text-muted small mt-3 mb-0">Creates a new table and seats you as East (dealer).</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Join Game</h5>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Game ID</label>
                        <input class="form-control" placeholder="MC-7X9Q" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Player name</label>
                        <input class="form-control" placeholder="Enter your name" />
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-outline-secondary">Join</button>
                    <span class="text-muted small">Use the invite code from your host.</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h5 class="card-title mb-0">Recent Tables</h5>
                        <p class="text-muted small mb-0">Mock list until lobby API is live.</p>
                    </div>
                    <span class="badge text-bg-light">Updated just now</span>
                </div>
                <div class="list-group list-group-flush mt-3">
                    @foreach (var table in Tables)
                    {
                        <div class="list-group-item lobby-row">
                            <div>
                                <div class="fw-semibold">@table.Name</div>
                                <div class="text-muted small">Host: @table.Host • Seats: @table.SeatsFilled / 4</div>
                            </div>
                            <div class="text-end">
                                <div class="badge text-bg-secondary">@table.Status</div>
                                <div class="small text-muted mt-1">@table.Code</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<TableView> Tables => new List<TableView>
    {
        new("Sunrise Table", "Aiko", "MC-7X9Q", "Waiting", 2),
        new("Downtown Tile Club", "Ravi", "MC-2K1L", "In progress", 4),
        new("Friday Practice", "Mina", "MC-4P8H", "Waiting", 3)
    };

    private record TableView(string Name, string Host, string Code, string Status, int SeatsFilled);
}
