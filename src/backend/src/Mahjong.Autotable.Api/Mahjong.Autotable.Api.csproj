<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Phase K Wave 10 — Bishop (Backend). StackExchange.Redis client
         for the durable RedisIdempotencyStore. The W9 surface shipped
         a wrapper-around-EF stub; W10 wires the real Redis client so
         multi-replica deployments share a single low-latency
         replay-window store instead of round-tripping through the
         backing RDBMS. The client is only consumed when
         `Idempotency:StoreImpl = "Redis"` so the package adds zero
         runtime cost to the in-memory/EF defaults. See
         docs/redis-idempotency.md for the operator runbook. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- Phase J Wave 8 — Sentry crash reporting (Apone, DevOps).
         Gated on Sentry:Dsn configuration: when the DSN is empty the
         SDK initializes but performs no network I/O. See docs/sentry.md
         for the operator runbook. -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <!-- Phase J Wave 8 — expose `internal` helpers (e.g.,
       SecurityHeadersMiddleware.HasContentHash) to the test assembly so
       Apone's contract tests for the Parcel content-hash detector
       compile without making the API surface artificially public.
       Vasquez (QA), 2026-05-XX. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mahjong.Autotable.Api.Tests" />
  </ItemGroup>

</Project>
