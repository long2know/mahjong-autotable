# Phase K Wave 8 — Apone (DevOps).
#
# Example tfvars for the staging edge stack. Copy + edit the
# operator-specific values (alb_dns_name, alb_zone_id) before
# `terraform apply`.

region      = "us-east-1"
domain_name = "staging.mahjong.example.com"

# Default true — the staging subdomain typically gets its own
# child zone delegated from the apex registrar. Set false +
# fill `existing_hosted_zone_id` to record `staging.*` directly
# in the apex `mahjong.example.com` zone.
create_hosted_zone      = true
existing_hosted_zone_id = ""

additional_subject_alt_names = []

# ── Operator-specific — replace these once the staging cluster's
# nginx-ingress controller is installed ───────────────────────────
# kubectl -n ingress-nginx get svc ingress-nginx-controller \
#     -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
alb_dns_name = "staging-alb-placeholder.us-east-1.elb.amazonaws.com"
# us-east-1 application load balancer canonical-hosted-zone id:
alb_zone_id = "Z35SXDOTRQ7X7K"

# WAF tuning — W8 baseline: count-only managed groups (see
# `main.tf` local `staging_waf_managed_rule_groups`), 1000 req
# per IP per 5 min rate limit, 30-day log retention.
waf_rate_limit_per_5min = 1000
logs_retention_days     = 30
