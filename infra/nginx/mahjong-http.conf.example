# Include at nginx http{} scope. For TLS, use the same location in your
# existing HTTPS server; do not replace existing certificates or server names.
map $http_upgrade $mahjong_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name mahjong.example.com;

    location / {
        # Host-published Compose port, NOT the container-internal 8080.
        # No URI suffix: preserve /autotable/, /api/, /hubs/ and WS paths.
        proxy_pass http://127.0.0.1:8950;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mahjong_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
